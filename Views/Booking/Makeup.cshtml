@model List<Nattapong_7379_L002.Models.ServiceItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "บริการช่างแต่งหน้า - Makeup Artist";
}

@section StorefrontHero {
    <partial name="_StorefrontHero" model='("บริการช่างแต่งหน้า", "บริการแต่งหน้าสำหรับถ่ายภาพ งานแต่ง และอีเวนต์", "~/images/header-makeup.webp")' />
}

<div class="ff-service-catalog-page py-3">

    @if (string.Equals(Context.Session.GetString("AccountRole"), "Admin", StringComparison.OrdinalIgnoreCase))
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a class="btn ff-btn-submit-olive rounded-pill px-4 shadow-sm" asp-controller="Admin" asp-action="CreateService" asp-route-type="Makeup">
                + เพิ่มช่างแต่งหน้า
            </a>
            <a class="btn btn-outline-dark btn-sm rounded-pill px-3" asp-controller="Admin" asp-action="Services" asp-route-type="Makeup">
                 ตารางจัดการช่างแต่งหน้าทั้งหมด
            </a>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            <h5>ยังไม่มีบริการช่างแต่งหน้าในขณะนี้</h5>
        </div>
    }
    else
    {
        <partial name="_ServiceCards" model="Model" />
    }
</div>

<!-- Modal จองบริการ -->
<dialog class="cafe-service-dialog" id="serviceBookingModal" aria-labelledby="modalServiceTitle">
    <div class="cafe-service-dialog-content">
        <button class="ff-modal-close-btn" type="button" data-close-service-booking aria-label="ปิดหน้าต่างการจอง">&times;</button>
        <div class="cafe-service-dialog-heading">
            <h2 class="ff-modal-title" id="modalServiceTitle">จองบริการช่างแต่งหน้า</h2>
            <p class="text-muted small" id="modalServicePrice">฿0</p>
        </div>
        <form asp-controller="Booking" asp-action="Book" method="post">
            <input type="hidden" name="ServiceType" id="modalServiceType" value="Makeup" />
            <input type="hidden" name="ItemName" id="modalItemName" value="" />
            <div class="ff-form-group mb-3">
                <p class="ff-form-label">บริการที่เลือก:</p>
                <div class="p-2 bg-light rounded small fw-bold text-dark" id="modalItemDisplay"></div>
            </div>
            <div class="ff-form-group mb-3">
                <label class="ff-form-label" for="serviceBookingBookingDate">วันที่ต้องการ:</label>
                <input id="serviceBookingBookingDate" name="BookingDate" type="date" class="form-control ff-input-control" required value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
            </div>
            <div class="ff-form-group mb-3">
                <label class="ff-form-label" for="serviceBookingTimeSlot">รอบเวลา:</label>
                <select id="serviceBookingTimeSlot" name="TimeSlot" class="form-select ff-input-control" required>
                    <option value="09:00 - 10:30 น.">09:00 - 10:30 น.</option>
                    <option value="11:00 - 12:30 น." selected>11:00 - 12:30 น.</option>
                    <option value="13:00 - 14:30 น.">13:00 - 14:30 น.</option>
                    <option value="15:00 - 16:30 น.">15:00 - 16:30 น.</option>
                </select>
            </div>
            <div class="ff-form-group mb-4">
                <label class="ff-form-label" for="serviceBookingNote">หมายเหตุ:</label>
                <textarea id="serviceBookingNote" name="Note" class="form-control ff-input-control" rows="2" placeholder="เช่น สไตล์ที่ต้องการ, แพ้สารอะไรเป็นพิเศษ"></textarea>
            </div>
            <div class="d-flex flex-column gap-2 mt-3">
                <button class="ff-btn-confirm-pay w-100 py-2 fw-bold" type="submit">ยืนยันการจอง</button>
                <div class="text-center small text-muted mt-1">ติดต่อสอบถามเพิ่มเติม LINE: <strong>@@cafephotostudio</strong></div>
            </div>
        </form>
    </div>
</dialog>

@section Scripts {
    <script type="module" src="~/js/service-booking.mjs" asp-append-version="true"></script>
}
