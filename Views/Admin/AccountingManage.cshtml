@model List<Nattapong_7379_L002.Models.Booking>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Accounting - Manage";
}

<div class="ff-role-workspace p-4 bg-white rounded-4 shadow-sm">
    <!-- Top Header with Pink Logout Button matching Figma -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-primary-subtle text-primary mb-1">ROLE WORKSPACE</span>
            <h3 class="fw-bold m-0">Accounting - Manage</h3>
            <p class="text-muted small m-0">ตรวจสอบรายการเดินบัญชี รายรับจากการจองสตูดิโอและยอดขายคาเฟ่</p>
        </div>
        <form asp-controller="Account" asp-action="LeaveAccount" method="post" class="m-0">
            <button type="submit" class="btn px-4 py-2 fw-bold rounded-3" style="background:#ff9aa2; color:#4a1c1c; border:none;">
                Logout
            </button>
        </form>
    </div>

    <!-- Horizontal Ledger Bars matching Figma -->
    <div class="d-flex flex-column gap-3">
        <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background:#e0e0e0;">
            <div>
                <span class="fw-bold text-dark">รายรับค่าสมัครสมาชิก VIP &amp; แพ็กเกจสตูดิโอ</span>
                <div class="small text-muted">ชำระผ่าน PromptPay QR Code • ตรวจสอบสลิปอัตโนมัติ</div>
            </div>
            <span class="fs-5 fw-bold text-success">+ ฿18,500.00</span>
        </div>

        <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background:#e0e0e0;">
            <div>
                <span class="fw-bold text-dark">รายรับยอดขายเครื่องดื่มและเบเกอรี่หน้าร้าน</span>
                <div class="small text-muted">สรุปยอดจาก Cashiers &amp; Staff ประจำวัน</div>
            </div>
            <span class="fs-5 fw-bold text-success">+ ฿12,450.00</span>
        </div>

        <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background:#e0e0e0;">
            <div>
                <span class="fw-bold text-dark">รายรับบริการช่างภาพ ช่างแต่งหน้า และเช่าชุด (@Model.Count รายการจอง)</span>
                <div class="small text-muted">ยอดรวมจากการจองบริการในระบบ</div>
            </div>
            <span class="fs-5 fw-bold text-success">+ ฿@( (Model.Count * 1500).ToString("N2") )</span>
        </div>

        <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background:#e0e0e0;">
            <div>
                <span class="fw-bold text-dark">รายจ่ายค่าวัตถุดิบกาแฟ และดูแลชุดสตูดิโอ</span>
                <div class="small text-muted">บันทึกต้นทุนประจำสัปดาห์</div>
            </div>
            <span class="fs-5 fw-bold text-danger">- ฿6,200.00</span>
        </div>
    </div>
</div>
