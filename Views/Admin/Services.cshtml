@model List<Nattapong_7379_L002.Models.ServiceItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "จัดการ" + ViewBag.ServiceTypeLabel;
    var serviceType = (string)ViewBag.ServiceType;
    var label = (string)ViewBag.ServiceTypeLabel;
}

<div class="ff-admin-page admin-service-page">
    <header class="admin-service-heading">
        <div>
            <h1>จัดการ@(label)</h1>
            <p>จัดการราคา รายละเอียด และการแสดงรายการ@(label) บนหน้าร้าน</p>
        </div>
        <a class="btn ff-btn-submit-olive admin-service-action" asp-controller="Admin" asp-action="CreateService" asp-route-type="@serviceType">
            <partial name="_UiIcon" model='"plus"' /> เพิ่ม@(label)ใหม่
        </a>
    </header>

    @if (!Model.Any())
    {
        <div class="admin-service-empty">
            <h2 class="h5">ยังไม่มีรายการ@(label)</h2>
            <p class="mb-0">กดปุ่มเพิ่ม@(label)ใหม่ เพื่อสร้างรายการแรก</p>
        </div>
    }
    else
    {
        <div class="cafe-table-frame" role="region" aria-label="ตารางบริการ" tabindex="0">
            <table class="table table-hover align-middle ff-admin-table mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th style="width:80px">รูป</th>
                        <th>ชื่อรายการ</th>
                        <th>รายละเอียด</th>
                        <th style="width:100px">ราคา</th>
                        <th style="width:100px">ราคาเดิม</th>
                        <th style="width:100px">ป้ายกำกับ</th>
                        <th style="width:80px">สถานะ</th>
                        <th style="width:140px">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.IsActive ? "table-secondary opacity-75" : "")">
                            <td class="fw-bold">@item.Id</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" style="width:60px;height:60px;object-fit:cover;border-radius:8px;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="width:60px;height:60px;border-radius:8px;"></div>
                                }
                            </td>
                            <td class="fw-bold">@item.Name</td>
                            <td class="small text-muted" style="max-width:200px;">@(item.Description?.Length >60 ? item.Description.Substring(0, 60) + "..." : item.Description)</td>
                            <td class="fw-bold text-success">฿@item.Price.ToString("N0")</td>
                            <td class="text-muted small">
                                @if (item.OriginalPrice.HasValue)
                                {
                                    <span class="text-decoration-line-through">฿@item.OriginalPrice.Value.ToString("N0")</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BadgeText))
                                {
                                    <span class="badge bg-@(item.BadgeColor ?? "secondary")">@item.BadgeText</span>
                                }
                            </td>
                            <td>
                                <form asp-action="ToggleServiceActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-success" : "btn-outline-secondary")" title="@(item.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")">
                                        @(item.IsActive ? "เปิด" : "ปิด")
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="EditService" asp-route-id="@item.Id">แก้ไข</a>
                                    <form asp-action="DeleteService" method="post" onsubmit="return confirm('ยืนยันลบรายการ &quot;@item.Name&quot; ?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">ลบ</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-2">
            ทั้งหมด @Model.Count รายการ | แสดงผลอยู่ @Model.Count(i =>i.IsActive) รายการ
        </div>
    }
</div>
