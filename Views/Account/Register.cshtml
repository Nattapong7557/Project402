@model Nattapong_7379_L002.ViewModel.RegisterStep1ViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "สมัครสมาชิก - ขั้นตอนที่ 1";
}

<!-- Floating Back to Login Pill -->
<a class="ff-auth-back-pill" asp-controller="Account" asp-action="Login" title="กลับหน้าเข้าสู่ระบบ">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span>กลับไปเข้าสู่ระบบ</span>
</a>

<div class="ff-auth-outer">
    <section class="ff-auth-card ff-auth-card-wide">
        <!-- 1. Left Visual Side: ภาพบรรยากาศและสิทธิประโยชน์การเป็นสมาชิก -->
        <div class="ff-auth-visual">
            <img class="ff-auth-image" src="~/images/cafe-auth.jpg" asp-append-version="true" alt="Café & photo Studio" />
            <div class="ff-auth-visual-overlay"></div>
            <div class="ff-auth-copy">
                <span class="ff-auth-tag">STEP 1 OF 3 &bull; REGISTER</span>
                <h2>มุมพักผ่อนและความทรงจำ เริ่มต้นที่นี่</h2>
                <p>สมัครสมาชิกเพื่อรับสิทธิพิเศษเต็มรูปแบบ ส่วนลดเมนูซิกเนเจอร์ และสิทธิ์การใช้งาน Photo Studio ระดับพรีเมียม</p>
                
                <div class="ff-auth-perks">
                    <div class="ff-perk-item">
                        <span class="ff-perk-icon"></span>
                        <span>รับ Welcome Drink และส่วนลด 10% ทุกเมนู</span>
                    </div>
                    <div class="ff-perk-item">
                        <span class="ff-perk-icon"></span>
                        <span>สิทธิ์จองสตูดิโอถ่ายภาพพร้อมผู้ช่วยจัดไฟ</span>
                    </div>
                    <div class="ff-perk-item">
                        <span class="ff-perk-icon"></span>
                        <span>รับเค้กหรือเครื่องดื่มฟรีในเดือนเกิดของคุณ</span>
                    </div>
                    <div class="ff-perk-item">
                        <span class="ff-perk-icon"></span>
                        <span>สะสมคะแนนแลกของรางวัลและกิจกรรม Workshop</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Right Form Side: ฟอร์มสมัครสมาชิก ขั้นตอนที่ 1 -->
        <div class="ff-auth-panel">
            <!-- Step Indicator Bar -->
            <div class="ff-step-progress mb-3">
                <div class="ff-step-item active">
                    <span class="ff-step-num">1</span>
                    <span class="ff-step-label">ข้อมูลบัญชี</span>
                </div>
                <div class="ff-step-line"></div>
                <div class="ff-step-item">
                    <span class="ff-step-num">2</span>
                    <span class="ff-step-label">เลือกแพ็กเกจ</span>
                </div>
                <div class="ff-step-line"></div>
                <div class="ff-step-item">
                    <span class="ff-step-num">3</span>
                    <span class="ff-step-label">ชำระเงิน</span>
                </div>
            </div>

            <div class="ff-auth-header text-center text-md-start">
                <span class="ff-auth-brand-badge">Café &amp; photo Studio</span>
                <h1 class="ff-auth-title">สร้างบัญชีสมาชิกใหม่</h1>
                <p class="text-muted small">ขั้นตอนที่ 1: กรอกข้อมูลส่วนตัวเพื่อสร้างบัญชีของคุณ</p>
            </div>

            <form class="ff-auth-form" asp-controller="Account" asp-action="RegisterStep1" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger ff-auth-alert" role="alert"></div>

                <div class="row g-2 g-md-3">
                    <!-- Name -->
                    <div class="col-12 col-sm-6">
                        <div class="ff-form-group">
                            <label class="ff-form-label" for="name">ชื่อ-นามสกุล</label>
                            <div class="ff-input-wrap">
                                <svg class="ff-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                <input asp-for="Name" id="name" class="ff-input-control" placeholder="ชื่อ-นามสกุล" autocomplete="name" required />
                            </div>
                            <span asp-validation-for="Name" class="ff-field-error"></span>
                        </div>
                    </div>

                    <!-- Username -->
                    <div class="col-12 col-sm-6">
                        <div class="ff-form-group">
                            <label class="ff-form-label" for="username">ชื่อผู้ใช้ (Username)</label>
                            <div class="ff-input-wrap">
                                <svg class="ff-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
                                </svg>
                                <input asp-for="Username" id="username" class="ff-input-control" placeholder="Username" autocomplete="username" required />
                            </div>
                            <span asp-validation-for="Username" class="ff-field-error"></span>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="col-12 col-sm-6">
                        <div class="ff-form-group">
                            <label class="ff-form-label" for="email">อีเมล (Email)</label>
                            <div class="ff-input-wrap">
                                <svg class="ff-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                <input asp-for="Email" id="email" type="email" class="ff-input-control" placeholder="example@email.com" autocomplete="email" required />
                            </div>
                            <span asp-validation-for="Email" class="ff-field-error"></span>
                        </div>
                    </div>

                    <!-- Phone Number -->
                    <div class="col-12 col-sm-6">
                        <div class="ff-form-group">
                            <label class="ff-form-label" for="phoneNumber">เบอร์โทรศัพท์</label>
                            <div class="ff-input-wrap">
                                <svg class="ff-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                                <input asp-for="PhoneNumber" id="phoneNumber" type="tel" class="ff-input-control" placeholder="08x-xxx-xxxx" autocomplete="tel" required />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="ff-field-error"></span>
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="col-12 col-sm-6">
                        <div class="ff-form-group">
                            <label class="ff-form-label" for="password">รหัสผ่าน (8 ตัวขึ้นไป)</label>
                            <div class="ff-input-wrap">
                                <svg class="ff-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <input asp-for="Password" id="password" type="password" class="ff-input-control" placeholder="อย่างน้อย 8 ตัวอักษร" autocomplete="new-password" required />
                            </div>
                            <span asp-validation-for="Password" class="ff-field-error"></span>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-12 col-sm-6">
                        <div class="ff-form-group">
                            <label class="ff-form-label" for="confirmPassword">ยืนยันรหัสผ่าน</label>
                            <div class="ff-input-wrap">
                                <svg class="ff-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                                <input asp-for="ConfirmPassword" id="confirmPassword" type="password" class="ff-input-control" placeholder="ยืนยันรหัสผ่านอีกครั้ง" autocomplete="new-password" required />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="ff-field-error"></span>
                        </div>
                    </div>
                </div>

                <button class="ff-auth-btn-primary mt-3" type="submit">
                    <span>ถัดไป: เลือกแพ็กเกจ (Step 2)</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>

                <div class="ff-auth-divider">
                    <span>มีบัญชีสมาชิกอยู่แล้ว?</span>
                </div>

                <a class="ff-auth-btn-secondary" asp-controller="Account" asp-action="Login">
                    กลับไปเข้าสู่ระบบ (Sign In)
                </a>
            </form>
        </div>
    </section>
</div>
