@model Nattapong_7379_L002.ViewModel.RegisterStep3ViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "ชำระเงินและยืนยันการสมัคร - ขั้นตอนที่ 3";
}

<!-- Floating Back to Step 2 Pill -->
<a class="ff-auth-back-pill" asp-controller="Account" asp-action="RegisterStep2" title="ย้อนกลับไปเปลี่ยนแพ็กเกจ">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span>ย้อนกลับไปเลือกแพ็กเกจ</span>
</a>

<div class="ff-auth-outer">
    <section class="ff-auth-card ff-auth-card-wide">
        <!-- 1. Left Visual Side -->
        <div class="ff-auth-visual">
            <img class="ff-auth-image" src="~/images/cafe-auth.jpg" asp-append-version="true" alt="Café & photo Studio" />
            <div class="ff-auth-visual-overlay"></div>
            <div class="ff-auth-copy">
                <span class="ff-auth-tag">STEP 3 OF 3 &bull; PAYMENT</span>
                <h2>ขั้นตอนสุดท้ายในการเป็นสมาชิก</h2>
                <p>ตรวจสอบแพ็กเกจและยืนยันเพื่อเปิดใช้งานบัญชี</p>
                
                <div class="ff-auth-perks">
                    <div class="ff-perk-item">
                        <span class="ff-perk-icon"></span>
                        <span>แสดงยอดตามแพ็กเกจที่เลือก</span>
                    </div>
                    <div class="ff-perk-item">
                        <span class="ff-perk-icon"></span>
                        <span>เปิดใช้งานระบบอัตโนมัติทันทีที่กดยืนยัน</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Right Form Side: ชำระเงินตาม Figma -->
        <div class="ff-auth-panel">
            <!-- Step Indicator Bar -->
            <div class="ff-step-progress mb-3">
                <div class="ff-step-item done">
                    <span class="ff-step-num"></span>
                    <span class="ff-step-label">ข้อมูลบัญชี</span>
                </div>
                <div class="ff-step-line active"></div>
                <div class="ff-step-item done">
                    <span class="ff-step-num"></span>
                    <span class="ff-step-label">เลือกแพ็กเกจ</span>
                </div>
                <div class="ff-step-line active"></div>
                <div class="ff-step-item active">
                    <span class="ff-step-num">3</span>
                    <span class="ff-step-label">ชำระเงิน</span>
                </div>
            </div>

            <div class="ff-auth-header text-center text-md-start">
                <span class="ff-auth-brand-badge">Café &amp; photo Studio</span>
                <h1 class="ff-auth-title">ชำระเงินและยืนยันการสมัคร</h1>
                <p class="text-muted small">ตรวจสอบแพ็กเกจและยอดค่าสมัครก่อนยืนยัน</p>
            </div>

            <form class="ff-auth-form" asp-controller="Account" asp-action="ConfirmRegister" method="post">
                <!-- Summary Card -->
                <div class="ff-payment-summary-card mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">ผู้สมัคร:</span>
                        <strong class="text-dark small">@Model.Name (@Model.Email)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">แพ็กเกจ:</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">@Model.SelectedPackage</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-bold">ยอดที่ต้องชำระ:</span>
                        <span class="ff-payment-amount">฿@Model.PackagePrice.ToString("N2")</span>
                    </div>
                </div>

                @if (Model.PackagePrice > 0)
                {
                    <p class="alert alert-info small mb-3">การชำระเงินเป็นแบบจำลอง ไม่มีการเรียกเก็บเงินจริง</p>
                }

                <!-- Green Confirmation Button ตาม Figma Menu-Register-step3 -->
                <button class="ff-btn-confirm-pay" type="submit">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>@(Model.PackagePrice > 0 ? "ยืนยันชำระเงินจำลอง" : "ยืนยันสมัครสมาชิกฟรี")</span>
                </button>

                <div class="d-flex justify-content-between mt-3">
                    <a class="btn btn-link text-decoration-none text-muted p-0" asp-controller="Account" asp-action="RegisterStep2">
                        &larr; ย้อนกลับไปเลือกแพ็กเกจ
                    </a>
                </div>
            </form>
        </div>
    </section>
</div>

