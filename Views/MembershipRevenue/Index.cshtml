@using Nattapong_7379_L002.Services.FoodOrdering
@model Nattapong_7379_L002.ViewModel.Membership.MembershipRevenueViewModel
@{
    ViewData["Title"] = "รายรับสมาชิก";
    var isOwner = string.Equals(Context.Session.GetString("AccountRole"), "Owner", StringComparison.OrdinalIgnoreCase);
}
<section class="work-page">
    <header class="work-heading d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1>รายรับสมาชิก</h1>
            <p>รายการรับเงินจากการยืนยันการสมัครสมาชิก Premium แบบจำลอง</p>
        </div>
        <a class="btn work-outline" asp-controller="@(isOwner ? "Owner" : "FoodStaff")" asp-action="@(isOwner ? "Index" : "Accounting")">
            <partial name="_UiIcon" model='"back"' /> กลับหน้าสรุป
        </a>
    </header>
    <div class="row row-cols-1 row-cols-sm-2 g-3 mb-4">
        <div class="col"><div class="card work-metric h-100"><span>ยอดสะสม</span><strong>฿@Model.Total.ToString("N2")</strong></div></div>
        <div class="col"><div class="card work-metric h-100"><span>ยอดเดือนนี้</span><strong>฿@Model.MonthlyTotal.ToString("N2")</strong></div></div>
    </div>
    <section class="card work-panel" aria-labelledby="member-history">
        <div class="work-panel-heading">
            <h2 class="h5 mb-1" id="member-history">ประวัติรับเงิน</h2>
            <p class="small text-muted mb-0">เรียงจากล่าสุด · เวลาไทย</p>
        </div>
        @if (Model.Payments.Count == 0)
        {
            <p class="work-empty mb-0">ยังไม่มีรายการรับเงินค่าสมาชิก</p>
        }
        else
        {
            <ul class="work-list list-unstyled mb-0">
                @foreach (var payment in Model.Payments)
                {
                    <li class="work-row">
                        <div>
                            <strong class="text-break">@payment.MemberName</strong>
                            <p class="small text-muted mb-0">#@payment.Id · @payment.Package · @FoodPricing.BangkokTime(payment.PaidAt).ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <strong class="text-nowrap">฿@payment.Amount.ToString("N2")</strong>
                    </li>
                }
            </ul>
        }
        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center gap-3 mt-3" aria-label="หน้ารายการรับเงิน">
                @if (Model.Page > 1)
                {
                    <a class="btn work-outline" asp-action="Index" asp-route-page="@(Model.Page - 1)">ก่อนหน้า</a>
                }
                <span>หน้า @Model.Page จาก @Model.PageCount</span>
                @if (Model.Page < Model.PageCount)
                {
                    <a class="btn work-outline" asp-action="Index" asp-route-page="@(Model.Page + 1)">ถัดไป</a>
                }
            </nav>
        }
    </section>
</section>
